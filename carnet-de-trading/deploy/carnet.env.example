# Configuration du service Carnet de Trading (systemd EnvironmentFile).
# Copier vers /etc/carnet/carnet.env puis : chown root:carnet, chmod 0640.
# Ne jamais versionner ce fichier une fois rempli (secrets locaux).

# -- Écoute ---------------------------------------------------------------
# Garder 127.0.0.1 : le reverse proxy (nginx/Caddy) assure le TLS public.
CARNET_HOST=127.0.0.1
CARNET_PORT=8080

# -- Environnement --------------------------------------------------------
# SIMULATION = marché synthétique déterministe (défaut, aucun ordre ne sort).
# DEMO       = uniquement pertinent avec le pont MT5 démo configuré depuis l'UI.
CARNET_ENV=SIMULATION
CARNET_SEED=20261101
CARNET_SIM_SPEED=60
CARNET_SIM_24_7=1
CARNET_TICK_SECONDS=1.0
CARNET_LOG_LEVEL=INFO

# -- Emplacements persistants --------------------------------------------
CARNET_DATA_DIR=/var/lib/carnet/data
CARNET_VAR_DIR=/var/lib/carnet/var
CARNET_BACKUP_DIR=/var/lib/carnet/backups

# -- Sécurité -------------------------------------------------------------
# Mot de passe initial du compte « admin » créé au premier démarrage.
# Laisser vide : un mot de passe aléatoire est alors écrit dans
# var/initial_credentials.txt (0600). Changer ce mot de passe après la
# première connexion, puis vider la variable.
CARNET_ADMIN_PASSWORD=
CARNET_SESSION_TTL_MINUTES=480
# Le mode réel reste interdit par construction : laisser à 0.
CARNET_ALLOW_REAL=0

# -- Alertes (facultatif) -------------------------------------------------
# Amorçage du canal d'alerte si rien n'est configuré dans l'interface.
# Peut être un webhook Slack, Discord, Teams ou une URL générique.
CARNET_WEBHOOK_URL=
